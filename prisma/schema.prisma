generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id            String     @id
  email         String     @unique
  password      String
  name          String
  role          user_role  @default(CUSTOMER)
  phone         String?
  loyaltyPoints Int        @default(0)
  cardNumber    String?    @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  lastLoginAt   DateTime?

  @@index([email])
  @@index([role])
  @@index([cardNumber])
}

model menu_items {
  id             String        @id
  name           String
  category       category
  price          Float
  cost           Float?        @default(0)
  image          String?
  description    String?
  available      Boolean       @default(true)
  featured       Boolean       @default(false)
  prepTime       Int?          @default(5)
  nutrients      String?
  moodBenefits   String?
  moodOrderStats String?       // JSON: { "happy": { "shown": 0, "ordered": 0 }, ... }
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  order_items    order_items[]

  @@index([available])
  @@index([category])
  @@index([featured])
}

model order_items {
  id         String     @id
  orderId    String
  menuItemId String
  quantity   Int
  price      Float
  subtotal   Float
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  menu_items menu_items @relation(fields: [menuItemId], references: [id])
  orders     orders     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([orderId])
}

model orders {
  id            String         @id
  orderNumber   String         @unique
  customerName  String?
  tableNumber   String?
  orderType     order_type     @default(DINE_IN)
  status        order_status   @default(PENDING)
  subtotal      Float
  tax           Float
  totalAmount   Float
  paymentMethod String?
  paymentStatus payment_status @default(UNPAID)
  moodContext   String?        // Stores mood when order was placed
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  completedAt   DateTime?
  order_items   order_items[]

  @@index([createdAt])
  @@index([status])
}

model inventory_items {
  id            String                @id
  name          String
  category      inventory_category
  currentStock  Float
  minStock      Float
  maxStock      Float
  unit          String
  costPerUnit   Float
  supplier      String
  status        inventory_status      @default(IN_STOCK)
  lastRestocked DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime

  @@index([category])
  @@index([status])
}

enum category {
  PIZZA
  APPETIZER
  HOT_DRINKS
  COLD_DRINKS
  SMOOTHIE
  PLATTER
  SAVERS
  VALUE_MEAL
}

enum order_type {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum order_status {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum payment_status {
  UNPAID
  PAID
  REFUNDED
}

enum user_role {
  CUSTOMER
  CASHIER
  COOK
  MANAGER
}

enum inventory_category {
  INGREDIENTS
  BEVERAGES
  PACKAGING
  SUPPLIES
}

enum inventory_status {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model expenses {
  id          String            @id
  category    expense_category
  date        DateTime
  amount      Float
  description String
  frequency   expense_frequency
  attachment  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime

  @@index([date])
  @@index([category])
  @@index([frequency])
}

enum expense_category {
  RENT_LEASE
  UTILITIES
  ADMINISTRATIVE_SALARIES
  SOFTWARE_SUBSCRIPTIONS
  MAINTENANCE
  OTHER
}

enum expense_frequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
}
