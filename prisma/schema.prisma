generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id            String     @id
  email         String     @unique
  password      String
  name          String
  role          user_role  @default(CUSTOMER)
  phone         String?
  loyaltyPoints Int        @default(0)
  cardNumber    String?    @unique
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime
  lastLoginAt   DateTime?

  @@index([email])
  @@index([role])
  @@index([cardNumber])
}

model menu_items {
  id                    String                    @id
  name                  String
  category              category
  price                 Float
  cost                  Float?                    @default(0)
  image                 String?
  description           String?
  available             Boolean                   @default(true)
  featured              Boolean                   @default(false)
  prepTime              Int?                      @default(5)
  nutrients             String?
  moodBenefits          String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime
  order_items           order_items[]
  menu_item_ingredients menu_item_ingredients[]
  menu_item_mood_stats  menu_item_mood_stats[]

  @@index([available])
  @@index([category])
  @@index([featured])
}

model order_items {
  id         String     @id
  orderId    String
  menuItemId String
  quantity   Int
  price      Float
  subtotal   Float
  createdAt  DateTime   @default(now())
  updatedAt  DateTime
  menu_items menu_items @relation(fields: [menuItemId], references: [id])
  orders     orders     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([orderId])
}

model orders {
  id                 String         @id
  orderNumber        String         @unique
  customerName       String?
  tableNumber        String?
  orderType          order_type     @default(DINE_IN)
  status             order_status   @default(PENDING)
  subtotal           Float
  tax                Float
  totalAmount        Float
  paymentMethod      String?
  paymentStatus      payment_status @default(UNPAID)
  moodContext        String?        // Stores mood when order was placed
  moodFeedbackGiven  Boolean        @default(false) // Track if customer already gave feedback
  linkedOrderId      String?        // Links reordered/related orders
  createdBy          String?        // User ID who created the order (cashier/manager) or "CUSTOMER" for phone orders
  processedBy        String?        // Cashier who processed the order (set when status changes from PENDING)
  deviceId           String?        // Device ID for guest order tracking
  createdAt          DateTime       @default(now())
  updatedAt          DateTime
  completedAt        DateTime?
  order_items        order_items[]

  @@index([createdAt])
  @@index([status])
  @@index([linkedOrderId])
  @@index([createdBy])
  @@index([deviceId])
  @@index([processedBy])
}

model inventory_items {
  id                    String                    @id
  name                  String
  category              inventory_category
  currentStock          Float
  minStock              Float
  maxStock              Float
  unit                  String
  costPerUnit           Float
  supplier              String
  status                inventory_status          @default(IN_STOCK)
  restockFrequencyDays  Int?                      @default(7) // How often this item is typically restocked
  lastRestocked         DateTime                  @default(now())
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime
  stock_transactions    stock_transactions[]
  menu_item_ingredients menu_item_ingredients[]

  @@index([category])
  @@index([status])
}

enum category {
  PIZZA
  APPETIZER
  HOT_DRINKS
  COLD_DRINKS
  SMOOTHIE
  PLATTER
  SAVERS
  VALUE_MEAL
}

enum order_type {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum order_status {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum payment_status {
  UNPAID
  PAID
  REFUNDED
}

enum user_role {
  CUSTOMER
  CASHIER
  COOK
  MANAGER
  ADMIN
}

enum inventory_category {
  INGREDIENTS
  BEVERAGES
  PACKAGING
  SUPPLIES
}

enum inventory_status {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model expenses {
  id          String            @id
  category    expense_category
  date        DateTime
  amount      Float
  description String
  frequency   expense_frequency
  attachment  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime

  @@index([date])
  @@index([category])
  @@index([frequency])
}

enum expense_category {
  RENT_LEASE
  UTILITIES
  ADMINISTRATIVE_SALARIES
  SOFTWARE_SUBSCRIPTIONS
  MAINTENANCE
  OTHER
}

enum expense_frequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
}

// Stock Transaction Enums
enum stock_transaction_type {
  IN
  OUT
}

enum stock_transaction_reason {
  PURCHASE
  ORDER
  WASTE
  ADJUSTMENT
  RECONCILIATION
}

// Stock Transactions Model
model stock_transactions {
  id              String                   @id
  inventoryItemId String
  type            stock_transaction_type
  reason          stock_transaction_reason
  quantity        Float
  referenceId     String? // Order ID, Purchase ID, etc.
  userId          String? // Who performed the transaction
  notes           String?
  createdAt       DateTime                 @default(now())
  inventory_item  inventory_items          @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([reason])
  @@index([referenceId])
  @@index([createdAt])
}

// Menu Item Ingredients (Recipe/BOM)
model menu_item_ingredients {
  id              String          @id
  menuItemId      String
  inventoryItemId String
  quantity        Float // Amount of inventory item needed per menu item
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  menu_item       menu_items      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventory_item  inventory_items @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}

// Mood types enum
enum mood_type {
  HAPPY
  ENERGETIC
  RELAXED
  EXCITED
  TIRED
  STRESSED
  ANXIOUS
  SAD
  DEPRESSED
  ANGRY
}

// Mood Settings - Configurable by Admin/Manager
model mood_settings {
  id                     String    @id
  mood                   mood_type @unique
  emoji                  String
  label                  String
  color                  String
  description            String
  supportMessage         String?
  scientificExplanation  String?
  beneficialNutrients    String?   // JSON array of nutrients
  preferredCategories    String?   // JSON array of category names
  excludeCategories      String?   // JSON array of categories to exclude
  preferredCategoryPoints Int      @default(10) // Points awarded for preferred categories
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime

  @@index([mood])
  @@index([isActive])
}

// Mood Feedback Configuration
model mood_feedback_config {
  id                        String   @id @default("default")
  // Baseline settings
  baselineThreshold         Int      @default(50)     // Orders needed before enabling feedback
  feedbackEnabled           Boolean  @default(false)  // Master toggle for feedback collection
  autoEnableFeedback        Boolean  @default(true)   // Auto-enable when baseline reached
  // Scoring weights
  orderRateWeight           Float    @default(0.6)    // 60% weight for order rate
  feedbackRateWeight        Float    @default(0.4)    // 40% weight for feedback rate
  // Recommendation algorithm weights
  moodBenefitsWeight        Int      @default(20)     // Points for mood benefits match
  preferredCategoryWeight   Int      @default(10)     // Points for preferred category
  featuredItemWeight        Int      @default(5)      // Points for featured items
  priceRangeWeight          Int      @default(5)      // Points for price range match
  historicalDataWeight      Int      @default(15)     // Points for historical success
  timeOfDayWeight           Int      @default(5)      // Points for time-based preference
  // UI settings
  showMoodReflection        Boolean  @default(true)   // Show mood reflection modal after order
  reflectionDelayMinutes    Int      @default(15)     // Wait time before showing reflection
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime
}

// Mood Order Statistics (aggregated per mood, not per item)
model mood_order_stats {
  id             String    @id
  mood           mood_type @unique
  totalShown     Int       @default(0)   // Times recommendations shown for this mood
  totalOrdered   Int       @default(0)   // Times items were ordered with this mood
  feedbackCount  Int       @default(0)   // Times feedback was received
  moodImproved   Int       @default(0)   // Times mood improved after order
  moodSame       Int       @default(0)   // Times mood stayed same
  moodWorse      Int       @default(0)   // Times mood got worse
  baselineReached Boolean  @default(false) // Whether this mood has enough data
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([mood])
  @@index([baselineReached])
}

// Menu Item Mood Statistics (per item per mood tracking)
model menu_item_mood_stats {
  id             String     @id
  menuItemId     String
  mood           mood_type
  timesShown     Int        @default(0)   // Times this item was shown for this mood
  timesOrdered   Int        @default(0)   // Times this item was ordered with this mood
  feedbackCount  Int        @default(0)   // Times feedback was received for this item+mood
  moodImproved   Int        @default(0)   // Times mood improved after ordering this item
  moodSame       Int        @default(0)   // Times mood stayed same
  moodWorse      Int        @default(0)   // Times mood got worse
  createdAt      DateTime   @default(now())
  updatedAt      DateTime

  menu_items     menu_items @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, mood])  // One record per item per mood
  @@index([menuItemId])
  @@index([mood])
}
